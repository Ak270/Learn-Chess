{
  "name": "mentor-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "e2e": "playwright test",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "copy-engine": "node scripts/copy-engine.mjs",
    "predev": "npm run copy-engine",
    "prebuild": "npm run copy-engine",
    "pretest": "npm run copy-engine",
    "validate:content": "tsx tools/validate-content.ts",
    "build:puzzles": "echo \"usage: zstd -dc lichess_db_puzzle.csv.zst | tsx tools/build-puzzles.ts 150\"",
    "check:licenses": "tsx tools/check-licenses.ts",
    "check:budget": "tsx tools/check-budget.ts",
    "build:endgames": "tsx tools/build-endgames.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "stockfish": "^19.0.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "chess.js": "^1.4.0",
    "dexie": "^4.4.6",
    "ts-fsrs": "^5.4.2"
  }
}